#!/usr/bin/env bash
set -euo pipefail

started_at=$(date +%s)

echo "Checking the static-site runtime..."
if ! command -v python3 >/dev/null 2>&1; then
  sudo apt-get update
  sudo apt-get install -y python3
fi

python3 --version
test -f index.html
test -f app.js
test -f fonts.js
test -f styles.css

echo "Orb setup complete in $(( $(date +%s) - started_at ))s; this static site has no package dependencies."
